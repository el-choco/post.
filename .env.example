DOCKERHUB_NAMESPACE=paquele
WEBMAIL_VERSION=latest
WEBMAIL_PORT=8886
# Optional: existing data directory on your Docker host (contains webmail.db and secret.key).
# WEBMAIL_DATA_DIR=./webmail/data

# Optional server-wide OAuth defaults for mail, calendars and cloud files.
# Leave blank when entering credentials through Account & connections / Calendar / Files in the webmail UI.
# Saved per-user UI settings take precedence; files can fall back to calendar settings.
# PUBLIC_BASE_URL is the public HTTPS webmail address, NOT the ONLYOFFICE address.
# Local calendars and public HTTPS CalDAV need none of these. See CALENDAR.md / FILES.md.
PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Set true only when users should be allowed to connect private/internal DAV servers.
ALLOW_PRIVATE_CALDAV=false

# Private file storage: per-file upload limit and per-user quota, in MiB.
# Trash counts towards the quota. Cloud uploads use encrypted temporary storage.
FILES_MAX_UPLOAD_MB=1024
FILES_QUOTA_MB=5120

# Optional document viewer/editor. See ONLYOFFICE.md for Nginx Proxy Manager setup.
# Use either docker-compose.yml OR the complete docker-compose.onlyoffice.yml stack.
# The optional stack sets ENABLED=true, INTERNAL_URL=http://onlyoffice and
# CALLBACK_BASE_URL=http://backend:3000 automatically (these three .env values are ignored).
# ONLYOFFICE_URL is the public HTTPS Office address reachable by the browser.
# Generate the shared secret on your server: openssl rand -hex 32
ONLYOFFICE_ENABLED=false
ONLYOFFICE_URL=
ONLYOFFICE_INTERNAL_URL=
ONLYOFFICE_CALLBACK_BASE_URL=
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_MAX_FILE_MB=50
ONLYOFFICE_VERSION=9.4.0.1
ONLYOFFICE_PORT=8888
